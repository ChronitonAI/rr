source `dirname $0`/util.sh
# Make rr SIGKILL every task created by clone() just after mapping its
# scratch memory, and then act as if it hadn't seen the mmap's result.
RR_KILL_TASK_AT_SCRATCH=clone-after-mmap record clone_killed_before_scratch$bitness
replay
check EXIT-SUCCESS
grep -q "child was killed" record.out || failed ": the child wasn't killed"
