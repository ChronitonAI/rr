source `dirname $0`/util.sh

# A child fails an rr assertion (with SYS_rrcall_fail_assertion) while its
# other thread is blocked in read() and its parent in waitpid(). Under
# test-monitor, rr starts its emergency debugger, and test-monitor connects
# gdb to it and asks for every thread's backtrace. rr must answer for the
# threads that aren't stopped without failing again.
save_exe "$TESTNAME"
_RR_TRACE_DIR="$workdir" test-monitor $TIMEOUT record.err \
    $RR_EXE $GLOBAL_OPTIONS record --bind-to-cpu=any $LIB_ARG $RECORD_ARGS \
    "./$TESTNAME-$nonce" 1> record.out 2> record.err
status=$?
# gdb's backtraces of the child's threads, e.g.
#   Thread 2 (Thread 1234.1236 (emergency_debug)):
#   #0  ...
# (Before gdb 10, without the thread's name: "Thread 2 (Thread 1234.1236):".)
gdb_threads=$(grep -cE '^Thread [0-9]+ \(Thread [0-9]+\.[0-9]+[ )]' record.err)
why=
if [[ $status != 124 ]]; then
  why="test-monitor exited with $status, not 124"
elif ! grep -q "sent SIGURG" record.err; then
  why="rr didn't notify test-monitor"
elif [[ $(grep -c "failed to hold" record.err) != 1 ]]; then
  why="rr didn't fail exactly one assertion"
elif [[ $gdb_threads != 2 ]]; then
  why="gdb showed $gdb_threads threads of the child, not 2"
elif grep -qE "Could not read registers|Truncated register" record.err; then
  why="gdb couldn't read a thread's registers"
elif ! grep -qE '^#[0-9]+ .*\bblocked_reader \(' record.err ||
     ! grep -qE '^#[0-9]+ .*\bfail_here \(' record.err; then
  why="gdb's backtraces don't show blocked_reader() and fail_here()"
fi
if [[ -n "$why" ]]; then
  failed ": $why"
  cat record.err
else
  passed
fi
