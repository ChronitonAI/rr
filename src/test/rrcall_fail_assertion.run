source `dirname $0`/util.sh

# SYS_rrcall_fail_assertion makes rr fail an assertion. Under test-monitor,
# rr then notifies test-monitor, which gathers information (including from
# rr's emergency debugger), kills everything and exits with 124.
save_exe "$TESTNAME"
_RR_TRACE_DIR="$workdir" test-monitor $TIMEOUT record.err \
    $RR_EXE $GLOBAL_OPTIONS record --bind-to-cpu=any $LIB_ARG $RECORD_ARGS \
    "./$TESTNAME-$nonce" 1> record.out 2> record.err
status=$?
why=
if [[ $status != 124 ]]; then
  why="test-monitor exited with $status, not 124"
elif ! grep -q "nonzero arguments rejected" record.out; then
  why="the rrcall with nonzero arguments wasn't rejected"
elif grep -q "EXIT-SUCCESS" record.out; then
  why="the rrcall returned"
elif [[ $(grep -c "Failing as the tracee asked" record.err) != 1 ]]; then
  why="rr didn't fail the assertion once"
elif ! grep -q "sent SIGURG" record.err; then
  why="rr didn't notify test-monitor"
fi
if [[ -n "$why" ]]; then
  failed ": $why"
  cat record.err
else
  passed
fi
