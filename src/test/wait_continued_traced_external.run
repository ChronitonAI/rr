source `dirname $0`/util.sh

# Run wait_continued_traced_external, with this script sending the SIGCONT
# from outside the recording.
mkfifo request ack
(exec 3<request 4>ack
 while read -u 3 pid; do
   # Only ever signal the test's child.
   [[ $pid =~ ^[0-9]+$ ]] && (( pid > 1 )) || break
   kill -CONT $pid
   echo -n x >&4
 done) &
sender=$!
record $TESTNAME "$workdir/request $workdir/ack"
# If the recording failed early, the sender may still be waiting.
kill $sender 2>/dev/null
wait $sender
replay
check 'EXIT-SUCCESS'
