source `dirname $0`/util.sh

# The tracee fails an rr assertion (with SYS_rrcall_fail_assertion). Under
# test-monitor, rr starts its emergency debugger, and test-monitor connects
# gdb to it and asks for the backtrace. gdb needs the tracee's auxv to find
# the symbols of a PIE executable and of its shared libraries.
save_exe "$TESTNAME"
_RR_TRACE_DIR="$workdir" test-monitor $TIMEOUT record.err \
    $RR_EXE $GLOBAL_OPTIONS record --bind-to-cpu=any $LIB_ARG $RECORD_ARGS \
    "./$TESTNAME-$nonce" 1> record.out 2> record.err
status=$?
why=
if [[ $status != 124 ]]; then
  why="test-monitor exited with $status, not 124"
elif ! grep -q "sent SIGURG" record.err; then
  why="rr didn't notify test-monitor"
elif ! grep -qE '^#[0-9]+ .*\bfail_here \(' record.err ||
     ! grep -qE '^#[0-9]+ .*\bmain \(' record.err; then
  why="gdb's backtrace doesn't show fail_here() and main()"
fi
if [[ -n "$why" ]]; then
  failed ": $why"
  cat record.err
else
  passed
fi
